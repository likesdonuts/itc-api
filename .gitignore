.env
__pycache__/
*.pyc

# Both rebuilt from the public IDS feed by 'python cli.py sync', large, and
# different every day.
data/ids/
data/investigations.json

# Rebuilt from the cases and the documents by 'python cli.py counsel' (and
# 'next-actions'), after every sync and fetch.
data/counsel.json
data/next_actions.json

# Federal Register notices the claims analysis read; fetched again on demand.
# The analyses themselves (data/claims/*.json) and data/claims_costs.csv are
# tracked: later phases pay for them.
data/claims/fr/
data/claims_costs.csv.lock

# The analytics app's page and data, rebuilt with the analytics.
site_analytics/

# Rebuilt in full by 'python cli.py analytics'. The model's review decisions
# are kept: each was paid for.
data/analytics/*
!data/analytics/review_decisions.json

# Text extracted (and OCR'd) from the source PDFs, which are not in git either.
data/claims/text/
data/counsel_text/
data/next_actions/text/
data/next_actions_costs.csv.lock

# Downloaded PDFs stay on this machine: gigabytes of them, and EDIS can serve
# them again ('python cli.py docs --existing'). The documents index that lists
# them is still tracked.
data/documents/

# Rebuilt from data/ by 'python cli.py render': a page per investigation, with
# no source of truth of its own.
site/
